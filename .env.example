# ==============================================================================
# Database Configuration
# ==============================================================================
# PostgreSQL connection string (e.g. Supabase, local PostgreSQL, or AWS RDS)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/usage_billing_db

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Secret key used for signing JWT access tokens (use a random 64-char hex string)
# You can generate one via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# ==============================================================================
# Safepay Payment Gateway Configuration
# ==============================================================================
# Environment: 'sandbox' for testing, 'production' for live payments
SAFEPAY_ENV=sandbox

# Base API URL:
# Sandbox:    https://sandbox.api.getsafepay.com
# Production: https://api.getsafepay.com
SAFEPAY_BASE_URL=https://sandbox.api.getsafepay.com

# Public merchant API key starting with 'sec_' (from Safepay Dashboard -> Developer)
SAFEPAY_API_KEY=sec_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Server merchant secret key in hex format (from Safepay Dashboard -> Developer)
SAFEPAY_SECRET_KEY=your_merchant_secret_key_hex_string_here

# Shared webhook secret used to verify HMAC signatures of incoming payment webhooks
# (from Safepay Dashboard -> Developer -> Webhooks)
SAFEPAY_WEBHOOK_SECRET=your_webhook_secret_hex_string_here

# Default currency code (e.g., PKR, USD)
SAFEPAY_CURRENCY=PKR
